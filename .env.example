# Copy to .env for local runs of the producer (python -m producer.handler is not
# wired yet; the Lambda reads these from its environment, set by Terraform).
KINESIS_STREAM_NAME=market-pipeline-dev-ticks
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
# Use https://api.binance.us from the United States.
FEED_BASE_URL=https://api.binance.com
LOG_LEVEL=INFO
AWS_REGION=us-east-1
