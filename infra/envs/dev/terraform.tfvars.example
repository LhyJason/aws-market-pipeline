aws_region          = "us-east-1"
feed_base_url       = "https://api.binance.us" # api.binance.com outside the US
symbols             = ["BTCUSDT", "ETHUSDT", "SOLUSDT"]
schedule_expression = "rate(1 minute)"
ingest_enabled      = true
lake_force_destroy  = false # true lets `terraform destroy` delete lake objects
alarm_email         = "" # you@example.com; confirm the subscription from the AWS email
